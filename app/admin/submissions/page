"use client";

import { useEffect, useMemo, useState } from "react";

type SubmissionItem = {
  id: string;
  cardName: string;
  setName?: string | null;
  quantity: number;
  condition: "MINT" | "NEAR_MINT";
  offeredBuyPrice: number;
  lineTotal: number;
};

type SubmissionStatus =
  | "PENDING"
  | "RECEIVED"
  | "REVIEWED"
  | "APPROVED"
  | "REJECTED"
  | "PAID";

type SellSubmission = {
  id: string;
  fullName: string;
  email: string;
  buylistId: string;
  notes?: string | null;
  status: SubmissionStatus;
  estimatedTotal: number;
  createdAt: string;
  updatedAt: string;
  items: SubmissionItem[];
};

const statusOptions: SubmissionStatus[] = [
  "PENDING",
  "RECEIVED",
  "REVIEWED",
  "APPROVED",
  "REJECTED",
  "PAID",
];

export default function AdminSubmissionsPage() {
  const [submissions, setSubmissions] = useState<SellSubmission[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("All");
  const [updatingId, setUpdatingId] = useState<string | null>(null);

  async function loadSubmissions() {
    try {
      setLoading(true);

      const res = await fetch("/api/admin/submissions", {
        cache: "no-store",
      });

      const data = await res.json().catch(() => null);

      if (!res.ok) {
        throw new Error(data?.error || "Failed to load submissions");
      }

      setSubmissions(Array.isArray(data) ? data : []);
    } catch (error) {
      console.error("Failed to load submissions:", error);
      alert(
        error instanceof Error ? error.message : "Failed to load submissions"
      );
      setSubmissions([]);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadSubmissions();
  }, []);

  async function updateSubmissionStatus(
    buylistId: string,
    nextStatus: SubmissionStatus
  ) {
    try {
      setUpdatingId(buylistId);

      const res = await fetch(`/api/admin/submissions/${buylistId}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ status: nextStatus }),
      });

      const data = await res.json().catch(() => null);

      if (!res.ok) {
        throw new Error(data?.error || "Failed to update status");
      }

      setSubmissions((prev) =>
        prev.map((submission) =>
          submission.buylistId === buylistId
            ? { ...submission, status: nextStatus }
            : submission
        )
      );
    } catch (error) {
      console.error("Failed to update status:", error);
      alert(error instanceof Error ? error.message : "Failed to update status");
    } finally {
      setUpdatingId(null);
    }
  }

  const statuses = useMemo(() => {
    const unique = Array.from(new Set(submissions.map((s) => s.status)));
    return ["All", ...unique];
  }, [submissions]);

  const filteredSubmissions = useMemo(() => {
    const term = search.trim().toLowerCase();

    return submissions.filter((submission) => {
      const matchesSearch =
        !term ||
        submission.fullName.toLowerCase().includes(term) ||
        submission.email.toLowerCase().includes(term) ||
        submission.buylistId.toLowerCase().includes(term) ||
        submission.items.some(
          (item) =>
            item.cardName.toLowerCase().includes(term) ||
            (item.setName || "").toLowerCase().includes(term)
        );

      const matchesStatus =
        statusFilter === "All" || submission.status === statusFilter;

      return matchesSearch && matchesStatus;
    });
  }, [submissions, search, statusFilter]);

  return (
    <main className="min-h-screen bg-black px-6 py-10 text-white">
      <div className="mx-auto max-w-7xl">
        <div className="mb-8">
          <h1 className="text-4xl font-bold text-yellow-400">
            Admin Submissions
          </h1>
          <p className="mt-3 text-zinc-400">
            Review customer card submissions, update statuses, and track
            estimated payouts.
          </p>
        </div>

        <div className="mb-8 grid gap-4 md:grid-cols-[1fr_220px]">
          <input
            type="text"
            placeholder="Search by customer, email, buylist ID, or card name..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="rounded-2xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-white outline-none focus:border-yellow-400"
          />

          <select
            value={statusFilter}
            onChange={(e) => setStatusFilter(e.target.value)}
            className="rounded-2xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-white outline-none focus:border-yellow-400"
          >
            {statuses.map((status) => (
              <option key={status} value={status}>
                {status}
              </option>
            ))}
          </select>
        </div>

        {loading ? (
          <div className="rounded-3xl border border-zinc-800 bg-zinc-950 p-10 text-center text-zinc-400">
            Loading submissions...
          </div>
        ) : filteredSubmissions.length === 0 ? (
          <div className="rounded-3xl border border-zinc-800 bg-zinc-950 p-10 text-center text-zinc-400">
            No submissions found.
          </div>
        ) : (
          <div className="space-y-6">
            {filteredSubmissions.map((submission) => {
              const totalItems = submission.items.reduce(
                (sum, item) => sum + item.quantity,
                0
              );

              return (
                <div
                  key={submission.id}
                  className="rounded-3xl border border-zinc-800 bg-zinc-950 p-6"
                >
                  <div className="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
                    <div className="flex-1">
                      <div className="flex flex-wrap items-center gap-3">
                        <h2 className="text-2xl font-bold text-white">
                          {submission.fullName}
                        </h2>

                        <span className="rounded-full border border-yellow-500/30 bg-yellow-500/10 px-3 py-1 text-sm font-semibold text-yellow-300">
                          {submission.status}
                        </span>
                      </div>

                      <div className="mt-3 grid gap-2 text-sm text-zinc-400 md:grid-cols-2">
                        <p>
                          <span className="text-zinc-500">Buylist ID:</span>{" "}
                          {submission.buylistId}
                        </p>
                        <p>
                          <span className="text-zinc-500">Email:</span>{" "}
                          {submission.email}
                        </p>
                        <p>
                          <span className="text-zinc-500">Submitted:</span>{" "}
                          {new Date(submission.createdAt).toLocaleString()}
                        </p>
                        <p>
                          <span className="text-zinc-500">Total Cards:</span>{" "}
                          {totalItems}
                        </p>
                      </div>

                      {submission.notes && (
                        <div className="mt-4 rounded-2xl border border-zinc-800 bg-black p-4">
                          <p className="text-sm text-zinc-500">Customer Notes</p>
                          <p className="mt-2 whitespace-pre-wrap text-zinc-300">
                            {submission.notes}
                          </p>
                        </div>
                      )}
                    </div>

                    <div className="rounded-2xl border border-zinc-800 bg-black p-5 lg:min-w-[240px]">
                      <p className="text-sm text-zinc-500">Estimated Payout</p>
                      <p className="mt-2 text-3xl font-bold text-yellow-400">
                        ${submission.estimatedTotal.toFixed(2)}
                      </p>

                      <div className="mt-5">
                        <label className="mb-2 block text-sm font-medium text-zinc-400">
                          Update Status
                        </label>

                        <select
                          value={submission.status}
                          onChange={(e) =>
                            updateSubmissionStatus(
                              submission.buylistId,
                              e.target.value as SubmissionStatus
                            )
                          }
                          disabled={updatingId === submission.buylistId}
                          className="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-white outline-none focus:border-yellow-400 disabled:cursor-not-allowed disabled:opacity-60"
                        >
                          {statusOptions.map((status) => (
                            <option key={status} value={status}>
                              {status}
                            </option>
                          ))}
                        </select>

                        {updatingId === submission.buylistId && (
                          <p className="mt-2 text-sm text-zinc-500">
                            Updating status...
                          </p>
                        )}
                      </div>
                    </div>
                  </div>

                  <div className="mt-6">
                    <h3 className="mb-4 text-lg font-semibold text-white">
                      Submitted Cards
                    </h3>

                    <div className="space-y-3">
                      {submission.items.map((item) => (
                        <div
                          key={item.id}
                          className="rounded-2xl border border-zinc-800 bg-black p-4"
                        >
                          <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                            <div>
                              <p className="text-lg font-semibold text-white">
                                {item.cardName}
                              </p>

                              {item.setName && (
                                <p className="mt-1 text-sm text-zinc-400">
                                  Set: {item.setName}
                                </p>
                              )}

                              <div className="mt-3 flex flex-wrap gap-3 text-sm text-zinc-300">
                                <span className="rounded-full border border-zinc-700 px-3 py-1">
                                  Condition:{" "}
                                  {item.condition === "MINT"
                                    ? "Mint"
                                    : "Near Mint"}
                                </span>

                                <span className="rounded-full border border-zinc-700 px-3 py-1">
                                  Quantity: {item.quantity}
                                </span>

                                <span className="rounded-full border border-zinc-700 px-3 py-1">
                                  Price Each: ${item.offeredBuyPrice.toFixed(2)}
                                </span>
                              </div>
                            </div>

                            <div className="text-left md:text-right">
                              <p className="text-sm text-zinc-500">Line Total</p>
                              <p className="text-2xl font-bold text-yellow-400">
                                ${item.lineTotal.toFixed(2)}
                              </p>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </main>
  );
}